# Optional basemap provider settings. The defaults work without an API key.
# Copy this file to .env.local only when changing the provider, then restart.
# Use the attribution required by your chosen provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'
