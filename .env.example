# Optional basemap provider settings. The defaults work without an API key.
# Copy this file to .env.local only when changing the provider, then restart.
# Use the attribution required by your chosen provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'

# Database mode is the default. Explicitly set demo to use browser sample data.
NEXT_PUBLIC_DATA_MODE=api
# Server-only URL, proxied by Next.js at /api/backend/* (no browser CORS needed).
RIKHANET_API_URL=http://127.0.0.1:8000

# Python reads these from the shell, not from Next.js .env.local.
# Defaults work with `docker compose up -d db` and a native Python API.
# PG_DSN=postgresql://rikhanet:rikhanet@127.0.0.1:5432/rikhanet
# GEWOG_SEED_PATH=.../gewogs_info (1).xlsx
# RIKHANET_UPLOAD_DIR=.../uploads/sightings
# MODEL_PATH=.../rikhanet_tft_binary.ckpt
# TRAINING_DATASET_PKL=.../models/training_dataset.pkl
# PREDICTION_PARITY_CSV=.../tft_test_predictions.csv
# PREDICTION_VALIDATION_PATH=.../models/prediction_validation.json

# Backend account/delivery environment (set in the Python shell or Compose .env).
# APP_ORIGIN=http://127.0.0.1:3000
# COOKIE_SECURE=0 # use 1 behind HTTPS
# RIKHANET_SECRET_KEY= # Fernet key; otherwise a protected local key file is created
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_SSL=0 # 1 for implicit TLS (normally port 465), otherwise STARTTLS
# RIKHANET_ALERT_WEBHOOK_URL=https://example.com/ranger-alert
# RIKHANET_WEBHOOK_SECRET= # at least 32 characters
